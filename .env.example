# NVIDIA API key from https://build.nvidia.com/settings/api-keys
#
# Deliberately NOT prefixed with VITE_ so Vite will not inline it into the
# client bundle. It is read by the dev proxy in vite.config.ts and by the
# Vercel Edge Function in api/nvidia/chat/completions.ts.
#
# Copy this file to .env.local and fill in your key.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

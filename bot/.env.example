# Copy to bot/.env for local runs, or install as /etc/bible-bot.env on the
# droplet (mode 600, owned by root). Never commit the filled-in copy.

# --- required -----------------------------------------------------------
# The family group. Run `npm run groups` once after pairing to list every
# group this account is in with its JID, then paste the right one here.
WHATSAPP_GROUP_JID=120363000000000000@g.us

# --- pairing ------------------------------------------------------------
# Digits only, country code included, no + or spaces. When set, the bot
# prints an 8-character pairing code to enter under
# WhatsApp > Settings > Linked devices > Link with phone number.
# Leave blank to be shown a QR code instead.
WHATSAPP_NUMBER=15551234567

# --- the site -----------------------------------------------------------
API_BASE=https://bible-terminal.vercel.app
# Only needed if BOT_TOKEN is also set on the Vercel project.
BOT_TOKEN=

# --- storage ------------------------------------------------------------
# Both must survive restarts. Losing AUTH_DIR means pairing the phone again
# by hand, so put it on a real disk -- never a container's ephemeral one.
AUTH_DIR=/var/lib/bible-bot/auth
DATA_DIR=/var/lib/bible-bot/data

# --- what to send -------------------------------------------------------
# Which parts of the reading go to the group, comma separated:
#   scripture       the verse or passage text
#   interpretation  the three-paragraph reading (over 2000 characters -- a lot
#                   to land in a group chat; it is always on the site)
#   question        the one-line discussion prompt (passage days only)
SEND_PARTS=scripture,question

# One day a week gets the full passage; the rest get a single verse. A passage
# every morning is more than a group reads, and a verse every morning never
# gives anyone something to sit with. 0 = Sunday, -1 = never.
WEEKLY_PASSAGE_DAY=0
# What the other six days send: verse, passage or ethiopian.
DAILY_SLOT=verse

# --- schedule -----------------------------------------------------------
# 6:10am, not 6:00: the site's warm cron runs at :02 past the hour and a cold
# generation takes 15-50s, so 6:00 would race it.
# Quoted: the value contains spaces and asterisks, and the helper scripts
# source this file with bash, which would otherwise glob-expand it and run
# "6 * * *" as a command.
SEND_AT="10 6 * * *"
TZ_NAME=America/New_York

# Send a reading missed while the process was down, but only this many hours
# past the scheduled time -- so a droplet that was off for a week does not
# wake up and post a stale passage at 3am.
CATCH_UP_HOURS=6

# Set to 1 to print the messages instead of sending them.
DRY_RUN=

{
  "name": "bible-terminal-bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Posts the daily passage from bible-terminal into a WhatsApp family group.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --test src/*.test.mjs",
    "dev": "npm run build && node dist/index.js",
    "groups": "npm run build && node dist/groups.js"
  },
  "dependencies": {
    "baileys": "6.7.24",
    "node-cron": "^4.6.0",
    "pino": "^9.5.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.5.3"
  }
}
